# ──────────────────────────────────────────────
# W2G Platform – .gitignore
# ──────────────────────────────────────────────

# Environment files (secrets)
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# EXCEPTIONS: Required for deployment
!backend/.env
!frontend/.env

# Sensitive credentials
memory/test_credentials.md

# Runtime storage (uploads, messages, documents)
storage/

# Test reports (may contain credentials from test runs)
test_reports/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.venv/
venv/
env/

# Node / Frontend
node_modules/
frontend/build/
frontend/coverage/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Logs
*.log
/var/log/

# Temporary files
tmp/
temp/
*.tmp

# Secrets / credentials (catch-all)
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
credentials.json
.credentials
